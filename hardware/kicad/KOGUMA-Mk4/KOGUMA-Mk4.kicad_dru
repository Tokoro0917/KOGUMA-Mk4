(version 1)

# 細かいピッチの IC のパッドどうしは、フットプリントの寸法のままで 0.15〜0.19mm しか離れていない
# (STM32H725 QFN-68 0.4mm ピッチ、LSM6DSR LGA-14 0.5mm、OPA2354 VSSOP-8 0.65mm)。
# 同じ IC のパッドの間だけ 0.14mm まで許し、ほかはネットクラスの 0.2mm のまま(ToraNeko.Mk3 と同じ考え方)
(rule "fine pitch pads U4"
  (constraint clearance (min 0.14mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U4') && B.intersectsCourtyard('U4')"))

(rule "fine pitch pads U76"
  (constraint clearance (min 0.14mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U76') && B.intersectsCourtyard('U76')"))

(rule "fine pitch pads U74"
  (constraint clearance (min 0.14mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U74') && B.intersectsCourtyard('U74')"))

(rule "fine pitch pads U75"
  (constraint clearance (min 0.14mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.intersectsCourtyard('U75') && B.intersectsCourtyard('U75')"))
