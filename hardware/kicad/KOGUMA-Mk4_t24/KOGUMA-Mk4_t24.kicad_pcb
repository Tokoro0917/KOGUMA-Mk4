				(size 0.8 0.8)
			)
		)
	)
	(gr_text "KOGUMA MK4 main board for tire 24mm (t24): outline t24v7 (mechanical/pcb/pcb_outline_t24v7.dxf), 0.6mm. Fixed by mechanics: J5/J6 encoder pads, D70-D77 wall sensor holders (bottom), D90-D96 UI LEDs (1608, same assignment as ToraNeko.Mk3), D98 front LED, H1-H4 M2 posts. Others: not placed yet"
		(at 100 58 0)
		(layer "Cmts.User")
		(uuid "09745da9-19a6-45fe-af63-e0010e359cd4")
		(effects
			(font
				(size 1 1)
			)
		)
	)
